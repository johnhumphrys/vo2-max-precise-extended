{
  "manifest_version": 3,
  "name": "VO2 Max Precise Extended for Garmin Connect",
  "version": "1.0.0",
  "description": "Shows the precise VO2 max on Garmin Connect, a daily chart with your age and sex ranges, and precise CSV/JSON export.",
  "homepage_url": "https://github.com/johnhumphrys/vo2-max-precise-extended",
  "content_scripts": [
    {
      "matches": ["https://connect.garmin.com/app/*"],
      "js": ["src/dates.js", "src/format.js", "src/api.js", "src/ranges.js", "src/chart.js", "src/dom.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "vo2-max-precise-extended@johnhumphrys.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
