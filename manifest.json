{
  "manifest_version": 3,
  "name": "Garmin VO2 Max (precise)",
  "version": "0.1.0",
  "description": "Shows Garmin Connect's precise VO2 max value and exports it as CSV or JSON.",
  "content_scripts": [
    {
      "matches": ["https://connect.garmin.com/app/*"],
      "js": ["src/dates.js", "src/format.js", "src/api.js", "src/ranges.js", "src/chart.js", "src/dom.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "garmin-vo2max-precise@johnhumphrys.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
